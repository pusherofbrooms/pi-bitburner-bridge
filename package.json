{
  "name": "pi-bitburner-bridge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "pi extension and WebSocket bridge for Bitburner 3.0 Remote API",
  "main": "src/index.ts",
  "scripts": {
    "bb": "node --import tsx src/cli.ts",
    "daemon": "node --import tsx src/bridge-daemon.ts --persistent",
    "test:pi": "node --import tsx scripts/pi-smoke.mjs",
    "test": "node --import tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "tsx": "^4.23.15",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@types/node": "^24.19.1",
    "@types/ws": "^8.18.2",
    "typescript": "^5.9.3",
    "@earendil-works/pi-ai": "1.0.4",
    "@earendil-works/pi-coding-agent": "1.0.4"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-ai": {
      "optional": true
    },
    "@earendil-works/pi-coding-agent": {
      "optional": true
    }
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  }
}
